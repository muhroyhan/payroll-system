# Copy to .env and adjust for your local environment. Never commit .env.

NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=payroll
DB_PASSWORD=payroll
DB_DATABASE=payroll_system
DB_LOGGING=false

# Redis (BullMQ — §2.2)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# CORS (B-01, 06_FRONTEND_GENERAL.md §13.5) — comma-separated allowed origins
# for apps/web. Defaults to the Vite dev server if unset.
CORS_ORIGIN=http://localhost:3001

# Bootstrap admin account (used only by the seed-admin-user seeder)
ADMIN_NAME=Default Admin
ADMIN_EMAIL=admin@payroll-system.local
ADMIN_PASSWORD=ChangeMe123!
